# ~/.config/mux/config — sourced by `mux` and `mux-watch`.
#
# HOSTS are ssh_config Host aliases (see examples/ssh_config), not raw
# hostnames: `mux` relies on your Host block supplying ControlMaster,
# ControlPath and ControlPersist.

HOSTS="remote jumpbox"          # space-separated; the first is the default
DEFAULT_HOST="remote"

LOCAL_ROOT="$HOME/code"         # `mux push foo` syncs $LOCAL_ROOT/foo/
REMOTE_ROOT=""                  # remote parent dir; empty = remote $HOME

MAX_PULL=100M                   # `mux pull` refuses anything larger
